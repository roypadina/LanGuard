// Shared.xcconfig
// Minimal shared configuration for scaffold tool customization
// All other settings use Xcode project defaults
// Generated by XcodeBuildMCP

// ==========================================
// Project Identity
// ==========================================
PRODUCT_NAME = LanGuard
PRODUCT_DISPLAY_NAME = LanGuard
PRODUCT_BUNDLE_IDENTIFIER = com.roy.languard
MARKETING_VERSION = 1.1.3
CURRENT_PROJECT_VERSION = 9

// ==========================================
// Platform Configuration
// ==========================================
MACOSX_DEPLOYMENT_TARGET = 14.0

// ==========================================
// Info PLIST
// ==========================================
GENERATE_INFOPLIST_FILE = YES
// Menu-bar agent: no Dock icon, no main window on launch.
INFOPLIST_KEY_LSUIElement = YES
// Connection protection reads the router's MAC (ARP) and probes the local network; without this
// macOS Local Network privacy hides the ARP table from the app.
INFOPLIST_KEY_NSLocalNetworkUsageDescription = LanGuard identifies your router and checks for a free address so connections survive switching between LAN and Wi-Fi.

// ==========================================
// Entitlements
// ==========================================
// AI agents can modify Config/LanGuard.entitlements to add capabilities
CODE_SIGN_ENTITLEMENTS = Config/LanGuard.entitlements

// ==========================================
// Code Signing — ad-hoc, no Apple Developer account required.
// LanGuard is a personal/local tool; sign to run locally.
// ==========================================
CODE_SIGN_STYLE = Manual
CODE_SIGN_IDENTITY = -
DEVELOPMENT_TEAM =
// App icon (Assets.xcassets/AppIcon.appiconset)
ASSETCATALOG_COMPILER_APPICON_NAME = AppIcon
